pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timestamps()
  }

  environment {
    REGISTRY = 'ghcr.io'
    GHCR_NAMESPACE = 'akshara-minoli'
    IMAGE_NAME = 'fixguard-notification'
    SERVICE_DIR = 'services/notification-service'
    TRIVY_IMAGE = 'aquasec/trivy:0.74.0'
  }

  stages {
    stage('Checkout') {
      steps {
        script {
          def scmInfo = checkout scm
          env.GIT_SHA = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
          env.IMAGE_REF = "${REGISTRY}/${GHCR_NAMESPACE}/${IMAGE_NAME}:${GIT_SHA}"
          
          def rawBranch = scmInfo?.GIT_BRANCH ?: env.GIT_BRANCH
          if (!rawBranch) {
            try {
              rawBranch = sh(script: 'git name-rev --name-only HEAD', returnStdout: true).trim()
            } catch (Exception e) {
              rawBranch = 'unknown'
            }
          }
          if (rawBranch) {
            rawBranch = rawBranch.replace('refs/heads/', '')
                                 .replace('refs/remotes/', '')
                                 .replace('origin/', '')
          }
          env.GIT_CURRENT_BRANCH = rawBranch ?: 'unknown'
          echo "Resolved Git branch: ${env.GIT_CURRENT_BRANCH}"
        }
      }
    }

    stage('Environment Verification') {
      steps {
        sh 'git --version'
        sh 'docker --version'
        sh 'docker info --format "{{.ServerVersion}}"'
        sh 'test -f "${SERVICE_DIR}/package-lock.json"'
      }
    }

    stage('Prepare Prisma Engines') {
      agent { docker { image 'node:22-alpine'; reuseNode true; args '-u root:root' } }
      steps {
        dir("${SERVICE_DIR}") {
          sh 'npm ci --ignore-scripts'
          retry(3) { sh 'npx prisma generate' }
          sh '''mkdir -p ../../.ci/prisma-engines
            cp node_modules/prisma/schema-engine-linux-musl-openssl-3.0.x ../../.ci/prisma-engines/
            cp node_modules/prisma/libquery_engine-linux-musl-openssl-3.0.x.so.node ../../.ci/prisma-engines/
            test -x ../../.ci/prisma-engines/schema-engine-linux-musl-openssl-3.0.x
            test -f ../../.ci/prisma-engines/libquery_engine-linux-musl-openssl-3.0.x.so.node'''
        }
      }
    }

    stage('Package Prisma Engines') {
      steps {
        sh 'docker build -f "${WORKSPACE}/ci/prisma-engines.Dockerfile" -t fixguard-prisma-engines:6.19.0 .ci/prisma-engines'
      }
    }

    stage('Dependencies, Prisma, Tests') {
      environment {
        PRISMA_SCHEMA_ENGINE_BINARY = '../../.ci/prisma-engines/schema-engine-linux-musl-openssl-3.0.x'
        PRISMA_QUERY_ENGINE_LIBRARY = '../../.ci/prisma-engines/libquery_engine-linux-musl-openssl-3.0.x.so.node'
      }
      agent {
        docker {
          image 'node:22-alpine'
          reuseNode true
          args '-u root:root'
        }
      }
      steps {
        dir("${SERVICE_DIR}") {
          sh 'npm ci'
          sh 'npx prisma generate'
          sh 'npm test'
          sh 'npm audit --audit-level=high || true'
        }
      }
    }

    stage('Docker Build') {
      steps {
        sh 'docker pull node:22-alpine'
        sh 'docker build -t "${IMAGE_REF}" "${SERVICE_DIR}"'
      }
    }

    stage('Image Secret Check') {
      steps {
        sh '''docker run --rm --entrypoint sh "${IMAGE_REF}" -c '
          test ! -f /app/.env
          test ! -d /app/.git
          test ! -d /app/coverage
          test -x /opt/prisma-engines/schema-engine-linux-musl-openssl-3.0.x
          test -f /opt/prisma-engines/libquery_engine-linux-musl-openssl-3.0.x.so.node
        ' '''
      }
    }

    stage('Trivy Scan') {
      steps {
        sh 'docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v fixguard-trivy-cache:/root/.cache/ "${TRIVY_IMAGE}" image --scanners vuln --severity HIGH,CRITICAL --exit-code 0 --ignore-unfixed "${IMAGE_REF}"'
        sh 'docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v fixguard-trivy-cache:/root/.cache/ "${TRIVY_IMAGE}" image --scanners vuln --severity CRITICAL --exit-code 1 --ignore-unfixed "${IMAGE_REF}"'
      }
    }

    stage('Push GHCR') {
      when {
        expression { env.GIT_CURRENT_BRANCH == 'main' }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'ghcr-credentials', usernameVariable: 'GHCR_USER', passwordVariable: 'GHCR_TOKEN')]) {
          sh 'echo "$GHCR_TOKEN" | docker login "${REGISTRY}" --username "$GHCR_USER" --password-stdin'
          sh 'docker push "${IMAGE_REF}"'
          sh 'docker tag "${IMAGE_REF}" "${REGISTRY}/${GHCR_NAMESPACE}/${IMAGE_NAME}:latest"'
          sh 'docker push "${REGISTRY}/${GHCR_NAMESPACE}/${IMAGE_NAME}:latest"'
        }
      }
    }
  }

  post {
    success {
      echo "Validated image: ${env.IMAGE_REF}"
    }
    failure {
      echo 'Pipeline failed; no later stage or registry push was allowed to continue.'
    }
    always {
      sh 'docker logout ghcr.io >/dev/null 2>&1 || true'
      deleteDir()
    }
  }
}

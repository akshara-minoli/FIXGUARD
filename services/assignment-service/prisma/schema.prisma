generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum TeamSpecialization {
  ROAD_MAINTENANCE
  STREETLIGHT
  WATER
  WASTE_MANAGEMENT
  DRAINAGE
  TRAFFIC_SIGNAL
  TREE_REMOVAL
  GENERAL
}
enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
model MaintenanceTeam {
  id             Int                @id @default(autoincrement())
  name           String             @unique @db.VarChar(140)
  code           String             @unique @db.VarChar(20)
  specialization TeamSpecialization
  serviceZoneId  Int                @map("service_zone_id")
  contactEmail   String?            @map("contact_email") @db.VarChar(254)
  contactPhone   String?            @map("contact_phone") @db.VarChar(30)
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignments    Assignment[]
  @@index([serviceZoneId, isActive])
  @@map("maintenance_teams")
}
model Assignment {
  id           String           @id @default(uuid()) @db.Uuid
  reportId     String           @map("report_id") @db.Uuid
  teamId       Int              @map("team_id")
  assignedBy   String           @map("assigned_by") @db.Uuid
  status       AssignmentStatus @default(ASSIGNED)
  instructions String?          @db.Text
  assignedAt   DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  startedAt    DateTime?        @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  team         MaintenanceTeam  @relation(fields: [teamId], references: [id], onDelete: Restrict)
  @@index([reportId, status])
  @@index([teamId, status])
  @@map("assignments")
}
